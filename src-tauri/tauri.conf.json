{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Unrestricted",
  "version": "../package.json",
  "identifier": "com.xiaohuangbo.deepseekunrestricted",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:8090",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DeepSeek Unrestricted",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "credentialless"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "DeepSeek Unrestricted 桌面客户端",
    "longDescription": "DeepSeek Unrestricted 的桌面壳：开一个窗口加载同一份前端构建产物，不新增功能；聊天、设置与存储仍全部由前端在窗口内完成。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
